APP_ENV=local

# Supabase Transaction pooler (porta 6543) para aplicação/Vercel.
# Nunca versione a senha real.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST.pooler.supabase.com:6543/postgres

VALOR_PASSAGEM=5.0
VALOR_PASSAGEM_A=5.0
VALOR_PASSAGEM_B=7.5
TEMPO_DUPLICIDADE=30
TEMPO_SEM_DADOS_ALERTA=120
REFRESH_SEGUNDOS=1

# Sessão administrativa
SESSION_SECRET=troque-por-uma-chave-secreta

# Enviada pelo ESP32 no cabeçalho X-API-Key
ESP32_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# ConectaVia
CONCESSIONARIA_A_USER=conectavia
CONCESSIONARIA_A_PASSWORD=defina-a-senha-no-ambiente

# RotaLink
CONCESSIONARIA_B_USER=rotalink
CONCESSIONARIA_B_PASSWORD=defina-a-senha-no-ambiente
